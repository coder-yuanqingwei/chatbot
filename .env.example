# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# Direct DeepSeek API (fallback when no custom API configured)
DEEPSEEK_API_KEY=****

# Custom OpenAI-compatible API (optional, overrides DeepSeek when configured)
# Supports any reverse proxy or self-hosted service with OpenAI-compatible endpoints
# CUSTOM_API_URL=https://your-proxy.example.com/v1
# CUSTOM_API_KEY=sk-xxx
# CUSTOM_MODEL_NAME=gpt-4o

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****
